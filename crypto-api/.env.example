# Klucz CoinMarketCap API (https://pro.coinmarketcap.com/account)
# Skopiuj ten plik do .env i wklej swój klucz. Plik .env NIE trafia do gita.
CMC_API_KEY=

# Port i adres serwera. Domyślnie tylko localhost – serwer przekazuje zapytania
# do CMC Twoim kluczem, więc nie wystawiaj go publicznie bez zabezpieczenia.
PORT=3000
HOST=127.0.0.1

# Jak długo (w minutach) trzymać w pamięci szybko zmieniające się dane
# (rynek globalny, listingi, sektory). Wyżej = mniej zużytych kredytów.
CACHE_TTL_MINUTES=10

# Co ile minut zapisywać lokalny snapshot rynku (do wykresów historycznych
# na darmowym planie). 0 = wyłączone. Jeden snapshot kosztuje ok. 3 kredyty.
SNAPSHOT_INTERVAL_MINUTES=60

# Ile dni historii snapshotów przechowywać (starsze niż 30 dni są przerzedzane do 1 dziennie).
SNAPSHOT_RETENTION_DAYS=3650

# 1 = tryb demo z wygenerowanymi danymi (bez zapytań do CMC).
CMC_MOCK=0
